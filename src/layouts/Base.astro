---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsApp from '../components/WhatsApp.astro';
import { site } from '../data/site';

interface Props {
  title: string; // título SEO completo
  description: string;
  image?: string;
  jsonLd?: object[];
  lang?: 'es' | 'en';
  alternates?: { lang: string; href: string }[];
  noindex?: boolean;
  type?: 'website' | 'article';
}

const { title, description, image = '/og.png', jsonLd = [], lang = 'es', alternates = [], noindex = false, type = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(image, site.url).href;

const org = {
  '@context': 'https://schema.org',
  '@type': 'AccountingService',
  '@id': `${site.url}/#organizacion`,
  name: site.name,
  legalName: site.legalName,
  url: `${site.url}/`,
  logo: `${site.url}/brand/os-mark.png`,
  image: `${site.url}/og.png`,
  email: site.email,
  ...(site.phoneDisplay ? { telephone: `+${site.whatsapp}` } : {}),
  address: {
    '@type': 'PostalAddress',
    ...(site.address.street ? { streetAddress: site.address.street } : {}),
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    ...(site.address.postalCode ? { postalCode: site.address.postalCode } : {}),
    addressCountry: site.address.country,
  },
  areaServed: [{ '@type': 'City', name: 'Rosario' }, { '@type': 'Country', name: 'Argentina' }],
  availableLanguage: ['es', 'en'],
  openingHours: 'Mo-Fr 09:00-18:00',
  ...(site.linkedin ? { sameAs: [site.linkedin] } : {}),
};
const schemas = [org, ...jsonLd];
---
<!doctype html>
<html lang={lang === 'es' ? 'es-AR' : 'en'} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={new URL(a.href, site.url).href} />)}
    <meta name="theme-color" content="#0A1A3B" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-64.png" sizes="64x64" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'es' ? 'es_AR' : 'en_AU'} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,500&display=swap" />

    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <slot name="head" />
  </head>
  <body>
    <a href="#contenido" class="skip-link">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <WhatsApp />

    <script>
      // Animación de entrada al hacer scroll
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); } });
        }, { rootMargin: '0px 0px -8% 0px' });
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
    {site.cfAnalyticsToken && (
      <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: site.cfAnalyticsToken })}></script>
    )}
  </body>
</html>
