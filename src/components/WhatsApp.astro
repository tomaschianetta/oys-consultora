---
// Botón flotante de WhatsApp: solo aparece si hay número cargado en site.ts
import { site } from '../data/site';
const msg = encodeURIComponent('Hola, quiero hacer una consulta al estudio.');
---
{site.whatsapp && (
  <a class="wa" href={`https://wa.me/${site.whatsapp}?text=${msg}`} target="_blank" rel="noopener" aria-label="Escribinos por WhatsApp">
    <svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3Zm0 23.7c-2 0-4-.6-5.7-1.6l-.4-.2-3.9 1 1-3.8-.3-.4A10.7 10.7 0 1 1 16 26.7Zm5.9-8c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-1 1.2-.2.2-.4.2-.7 0a8.8 8.8 0 0 1-4.4-3.8c-.3-.6.3-.5 1-1.7.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.8s1.2 3.2 1.4 3.5c.2.2 2.4 3.6 5.8 5 2.1.9 3 1 4 .8.7-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5-.1-.2-.3-.3-.6-.4Z"/></svg>
  </a>
)}

<style>
  .wa {
    position: fixed; right: 20px; bottom: 20px; z-index: 40; width: 56px; height: 56px; border-radius: 50%;
    display: grid; place-items: center; background: #1FA855; color: var(--white);
    box-shadow: 0 8px 24px rgba(0, 0, 0, .2); transition: transform .2s var(--ease);
  }
  .wa:hover { transform: scale(1.06); }
  .wa svg { width: 28px; height: 28px; }
</style>
