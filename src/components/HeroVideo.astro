---
// Fondo del hero: montaje por rubro con fundido cruzado (3 s por rubro).
// - Videos para todos (computadora y celular, cualquier conexión). Están recortados y comprimidos (~3 MB en total).
// - "Ahorro de datos" activado: solo la primera foto, fija.
// El montaje se pausa (y deja de descargar) cuando el inicio no está a la vista o la pestaña está oculta.
import { heroRubros } from '../data/rubros';
const clips = heroRubros.map((r) => ({ src: `/media/rubros/${r.id}.mp4`, poster: `/media/rubros/${r.id}.jpg`, label: r.label }));
const first = clips[0];
---
<div class="hv" data-hv data-clips={JSON.stringify(clips)} aria-hidden="true">
  <img class="hv-poster" src={first.poster} alt="" width="1280" height="720" fetchpriority="high" />
  <video class="hv-v" muted loop playsinline preload="none"></video>
  <video class="hv-v" muted loop playsinline preload="none"></video>
  <div class="hv-shade"></div>
</div>
<p class="hv-caption" data-hv-label aria-hidden="true">{first.label}</p>

<style>
  .hv { position: absolute; inset: 0; overflow: hidden; background: var(--navy-950); }
  .hv-poster, .hv-v { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hv-v { opacity: 0; transition: opacity .8s var(--ease); }
  .hv-v.is-on { opacity: 1; }
  .hv-shade {
    position: absolute; inset: 0;
    background: linear-gradient(100deg, rgba(6, 18, 42, .93) 0%, rgba(6, 18, 42, .75) 42%, rgba(6, 18, 42, .35) 100%),
      linear-gradient(0deg, rgba(6, 18, 42, .92), transparent 45%);
  }
  .hv-caption {
    position: absolute; right: var(--gutter); top: 120px; z-index: 2;
    font-size: 12px; letter-spacing: .16em; text-transform: uppercase; color: rgba(255, 255, 255, .8);
    transition: opacity .3s var(--ease);
  }
  @media (max-width: 700px) { .hv-caption { display: none; } }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-hv]');
  if (root) {
    const clips: { src: string; poster: string; label: string }[] = JSON.parse(root.dataset.clips || '[]');
    const label = document.querySelector<HTMLElement>('[data-hv-label]');
    const saveData = (navigator as any).connection?.saveData;
    const CLIP_MS = 3000; // tiempo en pantalla de cada rubro
    const FADE_MS = 800;

    // Dos <video> que se alternan
    const layers = [...root.querySelectorAll<HTMLVideoElement>('video')];

    let front = 0; // capa visible
    let index = -1; // rubro visible
    let timer: number | undefined;
    let active = false; // inicio a la vista y pestaña visible
    const ready = [false, false];

    // Carga el rubro k en la capa oculta
    const prepare = (k: number) => {
      const slot = 1 - front;
      const el = layers[slot];
      ready[slot] = false;
      el.dataset.k = String(k);
      el.src = clips[k].src;
      el.addEventListener('canplay', () => { ready[slot] = true; }, { once: true });
      el.load();
    };

    const swap = () => {
      if (!active) return;
      const slot = 1 - front;
      const el = layers[slot];
      if (!ready[slot]) { el.addEventListener('canplay', swap, { once: true }); return; } // todavía cargando
      el.currentTime = 0;
      el.play().catch(() => {});
      el.classList.add('is-on');
      const prev = layers[front];
      prev.classList.remove('is-on');
      front = slot;
      index = Number(el.dataset.k);
      if (label) {
        label.style.opacity = '0';
        setTimeout(() => { label.textContent = clips[index].label; label.style.opacity = '1'; }, 300);
      }
      // cuando termina el fundido, se pausa la capa anterior y se empieza a cargar el siguiente rubro
      setTimeout(() => { prev.pause(); prepare((index + 1) % clips.length); }, FADE_MS + 50);
      clearTimeout(timer);
      timer = window.setTimeout(swap, CLIP_MS);
    };

    const setActive = (on: boolean) => {
      if (on === active) return;
      active = on;
      const cur = layers[front];
      if (!on) { clearTimeout(timer); cur.pause(); return; }
      if (index < 0) { prepare(0); swap(); return; } // primer arranque
      cur.play().catch(() => {});
      timer = window.setTimeout(swap, CLIP_MS);
    };

    if (!saveData && clips.length) {
      let inView = true;
      let loaded = document.readyState === 'complete';
      const update = () => setActive(loaded && inView && !document.hidden);
      new IntersectionObserver(([e]) => { inView = e.isIntersecting; update(); }).observe(root);
      // Respaldo por posición de scroll (algunos navegadores demoran el observer)
      addEventListener('scroll', () => { inView = root.getBoundingClientRect().bottom > 0; update(); }, { passive: true });
      document.addEventListener('visibilitychange', update);
      // arrancamos después de que cargó la página, para no competir con el contenido
      if (loaded) update(); else addEventListener('load', () => { loaded = true; update(); }, { once: true });
    }
  }
</script>
