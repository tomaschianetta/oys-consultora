---
// Fondo del hero: montaje de videos por rubro con fundido cruzado (3 s por rubro).
// Mientras se ve un video, el siguiente ya se va cargando en el otro <video>.
// Se muestra a todos; solo con "ahorro de datos" activado queda la imagen fija.
import { heroRubros } from '../data/rubros';
const clips = heroRubros.map((r) => ({ src: `/media/rubros/${r.id}.mp4`, poster: `/media/rubros/${r.id}.jpg`, label: r.label }));
const first = clips[0];
---
<div class="hv" data-hv data-clips={JSON.stringify(clips)} aria-hidden="true">
  <img class="hv-poster" src={first.poster} alt="" width="1280" height="720" fetchpriority="high" />
  <video class="hv-v" muted loop playsinline preload="none"></video>
  <video class="hv-v" muted loop playsinline preload="none"></video>
  <div class="hv-shade"></div>
</div>
<p class="hv-caption" data-hv-label aria-hidden="true">{first.label}</p>

<style>
  .hv { position: absolute; inset: 0; overflow: hidden; background: var(--navy-950); }
  .hv-poster, .hv-v { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hv-v { opacity: 0; transition: opacity .8s var(--ease); }
  .hv-v.is-on { opacity: 1; }
  .hv-shade {
    position: absolute; inset: 0;
    background: linear-gradient(100deg, rgba(6, 18, 42, .93) 0%, rgba(6, 18, 42, .75) 42%, rgba(6, 18, 42, .35) 100%),
      linear-gradient(0deg, rgba(6, 18, 42, .92), transparent 45%);
  }
  .hv-caption {
    position: absolute; right: var(--gutter); top: 120px; z-index: 2;
    font-size: 12px; letter-spacing: .16em; text-transform: uppercase; color: rgba(255, 255, 255, .8);
    transition: opacity .3s var(--ease);
  }
  @media (max-width: 700px) { .hv-caption { display: none; } }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-hv]');
  if (root) {
    const clips: { src: string; poster: string; label: string }[] = JSON.parse(root.dataset.clips || '[]');
    const vids = [...root.querySelectorAll<HTMLVideoElement>('video')];
    const label = document.querySelector<HTMLElement>('[data-hv-label]');
    const saveData = (navigator as any).connection?.saveData;
    const CLIP_MS = 3000; // tiempo en pantalla de cada rubro
    const FADE_MS = 800;

    let front = 0; // índice del <video> visible
    let index = -1; // rubro visible
    let timer: number | undefined;
    const ready = [false, false];

    // Carga el rubro k en el <video> oculto
    const prepare = (k: number) => {
      const slot = 1 - front;
      const v = vids[slot];
      ready[slot] = false;
      v.src = clips[k].src;
      v.dataset.k = String(k);
      v.addEventListener('canplay', () => { ready[slot] = true; }, { once: true });
      v.load();
    };

    const swap = () => {
      const slot = 1 - front;
      const v = vids[slot];
      if (!ready[slot]) { v.addEventListener('canplay', swap, { once: true }); return; } // todavía cargando
      v.currentTime = 0;
      v.play().catch(() => {});
      v.classList.add('is-on');
      const prev = vids[front];
      prev.classList.remove('is-on');
      front = slot;
      index = Number(v.dataset.k);
      if (label) {
        label.style.opacity = '0';
        setTimeout(() => { label.textContent = clips[index].label; label.style.opacity = '1'; }, 300);
      }
      // cuando termina el fundido, el video anterior se pausa y empieza a cargar el siguiente
      setTimeout(() => { prev.pause(); prepare((index + 1) % clips.length); }, FADE_MS + 50);
      timer = window.setTimeout(swap, CLIP_MS);
    };

    if (!saveData && clips.length) {
      const start = () => { prepare(0); swap(); };
      // arrancamos después de que cargó la página, para no competir con el contenido
      if (document.readyState === 'complete') start(); else addEventListener('load', start, { once: true });
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) { clearTimeout(timer); vids[front].pause(); }
        else if (index >= 0) { vids[front].play().catch(() => {}); timer = window.setTimeout(swap, CLIP_MS); }
      });
    }
  }
</script>
