---
import Logo from './Logo.astro';
import { site } from '../data/site';
import { categories, servicesByCategory } from '../data/services';
import { segments } from '../data/segments';
const year = new Date().getFullYear();
---
<footer class="site-footer bg-navy">
  <div class="container">
    <div class="f-top">
      <div class="f-brand">
        <Logo tone="light" />
        <p>Estudio contable en Rosario. Más de 30 años ordenando los números de pymes, profesionales y emprendedores de todo el país.</p>
        <a href="/contacto/" class="btn btn-gold">Agendar consulta</a>
      </div>
      <div class="f-cols">
        {categories.slice(0, 2).map((cat) => (
          <div>
            <p class="f-title">{cat.title}</p>
            {servicesByCategory(cat.id).map((s) => <a href={`/servicios/${s.slug}/`}>{s.menuLabel ?? s.title}</a>)}
          </div>
        ))}
        <div>
          <p class="f-title">Para quién</p>
          {segments.map((s) => <a href={`/para-quien/${s.slug}/`}>{s.title}</a>)}
        </div>
        <div>
          <p class="f-title">Estudio</p>
          <a href="/nosotros/">Nosotros</a>
          <a href="/red-de-aliados/">Red de aliados</a>
          <a href="/recursos/">Recursos</a>
          <a href="/recursos/vencimientos/">Vencimientos</a>
          <a href="/en/" hreflang="en">International (EN)</a>
          <a href={site.portalUrl} rel="noopener nofollow">Acceso equipo</a>
        </div>
      </div>
    </div>

    <div class="f-contact">
      <div><span>Email</span><a href={`mailto:${site.email}`}>{site.email}</a></div>
      {site.phoneDisplay && <div><span>Teléfono</span><a href={`https://wa.me/${site.whatsapp}`}>{site.phoneDisplay}</a></div>}
      <div><span>Oficina</span><p>{site.address.street ? `${site.address.street}, ` : ''}{site.address.city}, {site.address.region}</p></div>
      <div><span>Horario</span><p>{site.hours}</p></div>
    </div>

    <div class="f-bottom">
      <p>© {year} {site.legalName}. Todos los derechos reservados.</p>
      <p>Rosario, Argentina · Sydney, Australia</p>
    </div>
  </div>
</footer>

<style>
  .site-footer { padding-block: 80px 32px; }
  .f-top { display: grid; grid-template-columns: minmax(260px, 1fr) 2.4fr; gap: 56px; padding-bottom: 56px; border-bottom: 1px solid var(--line-dark); }
  .f-brand { display: grid; gap: 22px; align-content: start; justify-items: start; }
  .f-brand p { color: #AFBDCD; font-size: 15px; max-width: 34ch; }
  .f-cols { display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; }
  .f-cols > div { display: grid; gap: 10px; align-content: start; }
  .f-title { font-size: 12px; letter-spacing: .16em; text-transform: uppercase; color: var(--gold-400); font-weight: 600; margin-bottom: 6px; }
  .f-cols a { color: #C9D4E0; text-decoration: none; font-size: 14.5px; }
  .f-cols a:hover { color: var(--white); }
  .f-contact { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 24px; padding-block: 36px; border-bottom: 1px solid var(--line-dark); }
  .f-contact span { display: block; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: #8193A8; margin-bottom: 4px; }
  .f-contact a, .f-contact p { color: var(--white); text-decoration: none; font-size: 15px; }
  .f-bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; padding-top: 28px; font-size: 13px; color: #8193A8; }
  @media (max-width: 900px) {
    .f-top { grid-template-columns: 1fr; }
    .f-cols { grid-template-columns: repeat(2, 1fr); }
  }
</style>
