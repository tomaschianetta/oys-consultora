---
// Preguntas frecuentes en acordeón nativo (<details>). El JSON-LD FAQPage
// lo agrega la página que lo usa, a través de Base.
import type { Faq } from '../data/services';
interface Props { items: Faq[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((f) => (
    <details>
      <summary><span>{f.q}</span><i aria-hidden="true"></i></summary>
      <p>{f.a}</p>
    </details>
  ))}
</div>

<style>
  .faq { border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary {
    list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 24px;
    padding: 24px 0; font-family: var(--serif); font-size: clamp(1.1rem, 1.6vw, 1.3rem); color: var(--navy-800);
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--navy-600); }
  i { position: relative; flex: none; width: 18px; height: 18px; }
  i::before, i::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1.5px; background: var(--gold-500); transition: transform .25s var(--ease); }
  i::after { transform: rotate(90deg); }
  details[open] i::after { transform: rotate(0); }
  details p { padding: 0 48px 26px 0; color: var(--muted); max-width: 70ch; }
</style>
