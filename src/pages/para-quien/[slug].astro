---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import Arrow from '../../components/Arrow.astro';
import { segments, type Segment } from '../../data/segments';
import { getService } from '../../data/services';
import { site } from '../../data/site';

export function getStaticPaths() {
  return segments.map((s) => ({ params: { slug: s.slug }, props: { segment: s } }));
}
const { segment } = Astro.props as { segment: Segment };
const svc = segment.services.map(getService).filter((s) => s !== undefined);
const others = segments.filter((s) => s.slug !== segment.slug);

const jsonLd = [{
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Para quién', item: `${site.url}/para-quien/` },
    { '@type': 'ListItem', position: 3, name: segment.title, item: `${site.url}/para-quien/${segment.slug}/` },
  ],
}];
---
<Base title={`${segment.seoTitle} | O&S Consultora`} description={segment.seoDescription} jsonLd={jsonLd}>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Para quién', href: '/para-quien/' }, { label: segment.title }]} />
      <p class="eyebrow">{segment.title}</p>
      <h1>{segment.tagline}</h1>
      <p class="lede">{segment.intro}</p>
      <div><a href="/contacto/" class="btn btn-gold">Agendar diagnóstico sin cargo <Arrow /></a></div>
    </div>
  </section>

  <section class="section">
    <div class="container cols">
      <div class="col reveal">
        <p class="eyebrow">Tus desafíos</p>
        <h2 class="h3">Lo que más preocupa a {segment.title.toLowerCase()}</h2>
        <ul class="dash-list">{segment.challenges.map((c) => <li>{c}</li>)}</ul>
      </div>
      <div class="col reveal">
        <p class="eyebrow">Cómo te ayudamos</p>
        <h2 class="h3">Lo que hacemos por vos</h2>
        <ul class="check-list">{segment.howWeHelp.map((c) => <li>{c}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Servicios recomendados</p>
        <h2>Por dónde suelen empezar.</h2>
      </div>
      <div class="grid g-2">
        {svc.map((s) => (
          <a href={`/servicios/${s!.slug}/`} class="card reveal">
            <h3>{s!.title}</h3>
            <p>{s!.short}</p>
            <span class="card-foot">Ver servicio <Arrow /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <p class="eyebrow">También trabajamos con</p>
      <div class="others">
        {others.map((o) => <a href={`/para-quien/${o.slug}/`} class="link-arrow">{o.title} <Arrow /></a>)}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 72px); }
  .col { display: grid; gap: 18px; align-content: start; padding: clamp(24px, 3vw, 40px); background: var(--white); border: 1px solid var(--line); }
  .col li { font-size: 1.05rem; }
  .others { display: flex; flex-wrap: wrap; gap: 28px; margin-top: 18px; }
  @media (max-width: 860px) { .cols { grid-template-columns: 1fr; } }
</style>
